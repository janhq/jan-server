            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"sandbox_shell_exec\",\n    \"arguments\": {\n      \"command\": \"mkdir -p /home/user/workspace/{{sandbox_conversation_id}} && echo sandbox-ok\"\n    }\n  },\n  \"id\": 10\n}"
            },
            "url": "{{mcp_url}}/v1/mcp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rawBody = pm.response.text();",
                  "let payload = null;",
                  "try {",
                  "  payload = JSON.parse(rawBody);",
                  "} catch (err) {",
                  "  const lines = rawBody.split('\\n');",
                  "  for (const line of lines) {",
                  "    if (line.startsWith('data: ')) {",
                  "      payload = JSON.parse(line.substring(6));",
                  "      break;",
                  "    }",
                  "  }",
                  "}",
                  "pm.test('Sandbox tool call succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(payload).to.be.an('object');",
                  "});",
                  "if (payload && payload.error) {",
                  "  pm.test('MCP error is absent', function () {",
                  "    pm.expect(payload.error).to.be.undefined;",
                  "  });",
                  "  return;",
                  "}",
                  "if (payload && payload.result && payload.result.isError) {",
                  "  pm.test('Result isError is false', function () {",
                  "    pm.expect(payload.result.isError).to.eql(false);",
                  "  });",
                  "  return;",
                  "}",
                  "const textBlock = payload.result.content.find(c => c.type === 'text');",
                  "pm.test('Shell exec returns stdout', function () {",
                  "  pm.expect(textBlock).to.exist;",
                  "  const structured = JSON.parse(textBlock.text);",
                  "  pm.expect(structured.stdout).to.include('sandbox-ok');",
                  "});"
                ]
              }
            }
          ]
