    {
      "name": "03-oauth-initiate",
      "item": [
        {
          "name": "Initiate GitHub OAuth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{gateway_url}}/v1/connectors/github/connect"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Accept 200 (auth URL returned) or 400/404 (not configured/invalid)",
                  "pm.expect(pm.response.code).to.be.oneOf([200, 400, 404, 500]);",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.property('auth_url');",
                  "  pm.expect(data.auth_url).to.be.a('string');",
                  "  pm.expect(data.auth_url).to.include('github.com');",
                  "  pm.collectionVariables.set('github_auth_url', data.auth_url);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Initiate Gmail OAuth",
