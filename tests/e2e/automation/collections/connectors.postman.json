{
  "info": {
    "name": "jan-server connectors",
    "description": "OAuth connector integration tests for GitHub, Gmail, Google Drive, and Google Calendar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-list-connectors",
      "item": [
        {
          "name": "List Available Connectors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{gateway_url}}/v1/connectors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property('connectors');",
                  "pm.expect(data.connectors).to.be.an('array');",
                  "",
                  "// Store connector types for later tests",
                  "const connectorTypes = data.connectors.map(c => c.type);",
                  "pm.collectionVariables.set('connector_types', JSON.stringify(connectorTypes));",
                  "",
                  "// Check for expected connector types",
                  "const expectedTypes = ['github', 'gmail', 'google_drive', 'google_calendar'];",
                  "expectedTypes.forEach(type => {",
                  "  const connector = data.connectors.find(c => c.type === type);",
                  "  if (connector) {",
                  "    pm.expect(connector).to.have.property('display_name');",
                  "    pm.expect(connector).to.have.property('enabled');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
