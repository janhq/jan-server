        {
          "name": "Create Message - With Conversation Reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response may include conversation context\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.type).to.equal('message');",
                  "    // Conversation context is optional extension",
