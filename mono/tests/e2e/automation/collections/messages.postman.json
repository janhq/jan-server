{
  "info": {
    "name": "jan-server messages (Anthropic API)",
    "description": "Test collection for Anthropic Messages API compatibility. Tests the /v1/messages endpoint for Claude Code API compatibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "model_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "conversation_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Guest Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has access_token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/auth/guest-login",
              "host": ["{{gateway_url}}"],
              "path": ["auth", "guest-login"]
            }
          },
          "response": []
        },
        {
          "name": "List Models",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Models array returned and model_id set\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        pm.collectionVariables.set('model_id', jsonData.data[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/v1/models",
              "host": ["{{gateway_url}}"],
              "path": ["v1", "models"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Basic Message Creation",
      "item": [
        {
          "name": "Create Message - Simple Text",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('type', 'message');",
                  "    pm.expect(jsonData).to.have.property('role', 'assistant');",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "    pm.expect(jsonData).to.have.property('model');",
                  "    pm.expect(jsonData).to.have.property('usage');",
                  "    pm.collectionVariables.set('message_id', jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Content has text block\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var textBlocks = jsonData.content.filter(c => c.type === 'text');",
                  "    pm.expect(textBlocks.length).to.be.greaterThan(0);",
                  "    pm.expect(textBlocks[0].text).to.be.a('string');",
                  "});",
                  "",
                  "pm.test(\"Usage contains token counts\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.usage).to.have.property('input_tokens');",
                  "    pm.expect(jsonData.usage).to.have.property('output_tokens');",
                  "    pm.expect(jsonData.usage.input_tokens).to.be.a('number');",
                  "    pm.expect(jsonData.usage.output_tokens).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model_id}}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Say hello in exactly 5 words.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/v1/messages",
              "host": ["{{gateway_url}}"],
              "path": ["v1", "messages"]
            }
          },
          "response": []
        },
