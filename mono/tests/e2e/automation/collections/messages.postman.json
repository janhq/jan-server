                  "    if (toolUseBlocks.length > 0) {",
                  "        pm.expect(toolUseBlocks[0]).to.have.property('id');",
                  "        pm.expect(toolUseBlocks[0]).to.have.property('name');",
                  "        pm.expect(toolUseBlocks[0]).to.have.property('input');",
                  "        pm.collectionVariables.set('tool_use_id', toolUseBlocks[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
