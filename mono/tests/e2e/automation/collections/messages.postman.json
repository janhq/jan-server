      "item": [
        {
          "name": "Count Tokens - Simple Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has input_tokens\", function () {",
                  "    var jsonData = pm.response.json();",
