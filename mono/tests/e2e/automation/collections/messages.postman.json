                  "    pm.expect(body).to.include('event: content_block_delta');",
                  "    pm.expect(body).to.include('event: content_block_stop');",
                  "    pm.expect(body).to.include('event: message_delta');",
                  "    pm.expect(body).to.include('event: message_stop');",
                  "});"
                ],
                "type": "text/javascript"
              }
