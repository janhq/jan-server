# ============================================
# Jan Server Mono - Environment Variables
# ============================================
# Copy this file to .env and update the values for your environment.
#
# Quick start:
#   cp .env.template .env
#   make docker-up
#
# Or use the interactive setup:
#   make quickstart

# ============================================
# Server Configuration
# ============================================
HTTP_PORT=8080
METRICS_PORT=9091
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console
ENABLE_SWAGGER=true
AUTO_MIGRATE=true

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection (used by Docker Compose)
POSTGRES_USER=jan
POSTGRES_PASSWORD=jan
POSTGRES_DB=jan
POSTGRES_PORT=5432

# Connection string (auto-configured in Docker, set manually for local dev)
# DB_POSTGRESQL_WRITE_DSN=postgresql://jan:jan@localhost:5432/jan?sslmode=disable

# ============================================
# Authentication - Local (Default)
# ============================================
# Local authentication uses PostgreSQL + bcrypt (no external dependencies)
LOCAL_AUTH_ENABLED=true

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
LOCAL_JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

LOCAL_JWT_ISSUER=jan-server
LOCAL_JWT_EXPIRATION=24h
LOCAL_JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# ============================================
# Authentication - Keycloak (Optional)
# ============================================
# Enable Keycloak for enterprise OIDC authentication
# Start with: make docker-up-keycloak
KEYCLOAK_ENABLED=false
KEYCLOAK_BASE_URL=http://keycloak:8085
KEYCLOAK_PUBLIC_URL=http://localhost:8085
KEYCLOAK_REALM=jan
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8085

# Keycloak client settings (configure in Keycloak admin console)
BACKEND_CLIENT_ID=backend
BACKEND_CLIENT_SECRET=backend-secret
CLIENT=jan-client
ISSUER=http://keycloak:8085/realms/jan
ACCOUNT=http://keycloak:8085/realms/jan/account
OIDC_DISCOVERY_URL=http://keycloak:8085/realms/jan/.well-known/openid-configuration
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# ============================================
# API Keys
# ============================================
API_KEY_PREFIX=jan_
API_KEY_DEFAULT_TTL=2160h
API_KEY_MAX_TTL=2160h
API_KEY_MAX_PER_USER=10

# ============================================
# S3 Storage (MinIO)
# ============================================
# MinIO is included in Docker Compose for local S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=jan-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
MEDIA_PRESIGN_TTL=1h
MEDIA_MAX_UPLOAD_SIZE=104857600

# MinIO console ports
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# Web Frontend
# ============================================
WEB_PORT=3001
VITE_API_URL=http://localhost:8080

# ============================================
# LLM Provider Configuration
# ============================================
# Configure your LLM provider(s) - providers are managed via admin API
# or bootstrap configuration file

# Default provider settings
# DEFAULT_PROVIDER_URL=https://api.openai.com/v1
# DEFAULT_PROVIDER_API_KEY=sk-...

MODEL_PROVIDER_SECRET=jan-model-provider-secret-2024
MODEL_SYNC_ENABLED=true
MODEL_SYNC_INTERVAL_MINUTES=60
STREAM_TIMEOUT=600s

# ============================================
# Memory Service (Optional)
# ============================================
# Enable for long-term context and semantic retrieval
MEMORY_ENABLED=false
MEMORY_BASE_URL=http://memory-tools:8090
MEMORY_TIMEOUT=5s
MEMORY_EMBEDDING_MODEL=bge-m3

# ============================================
# Search Providers (Optional)
# ============================================
# Enable at least one for web search functionality
# Providers are tried in order: Serper -> Exa -> Tavily -> SearXNG

# Serper (https://serper.dev)
SERPER_ENABLED=false
SERPER_API_KEY=

# Exa (https://exa.ai)
EXA_ENABLED=false
EXA_API_KEY=

# Tavily (https://tavily.com)
TAVILY_ENABLED=false
TAVILY_API_KEY=

# SearXNG (self-hosted)
SEARXNG_ENABLED=false
SEARXNG_URL=

# ============================================
# Code Sandbox (Optional)
# ============================================
# Provider for code execution: "e2b" or "aio"
SANDBOX_PROVIDER=

# E2B (https://e2b.dev)
E2B_API_KEY=

# AIO Sandbox (self-hosted)
AIO_SANDBOX_URL=

# ============================================
# Image Generation (Optional)
# ============================================
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_TIMEOUT=120s
IMAGE_DEFAULT_MODEL=z-image

# ============================================
# Realtime / WebRTC (Optional)
# ============================================
# Requires LiveKit server
REALTIME_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================
# OAuth Connectors (Optional)
# ============================================
# GitHub
GITHUB_CONNECTOR_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (Gmail, Drive, Calendar)
GOOGLE_CONNECTOR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connector security
CONNECTOR_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_FRONTEND_URL=http://localhost:3001

# ============================================
# Redis (Optional)
# ============================================
# Start with: make docker-up-redis
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ============================================
# Kong Gateway (Optional)
# ============================================
KONG_ENABLED=false
KONG_ADMIN_URL=http://kong:8001

# ============================================
# Conversation Features
# ============================================
CONVERSATION_SHARING_ENABLED=false
CONVERSATION_TITLE_GENERATION_ENABLED=false
CONVERSATION_TITLE_GENERATION_MODEL_ID=

# ============================================
# Observability (Optional)
# ============================================
SERVICE_NAME=jan-server
SERVICE_NAMESPACE=jan

# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Analytics
ANALYTICS_ENABLED=false
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
