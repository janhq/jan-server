# ============================================================================
# Jan Server Environment Configuration Template
# ============================================================================
# Copy this file to .env and customize for your environment
# 
# Quick Start:
#   make env-create              # Creates .env from this template
#   make env-switch ENV=hybrid   # Switch to hybrid development mode
#
# Available Environments:
#   - development  (all services in Docker)      - config/development.env
#   - hybrid       (native services + Docker)    - config/hybrid.env
#   - testing      (integration testing)         - config/testing.env
#   - production   (production deployment)       - config/production.env.example
#
# Documentation: See config/README.md for detailed environment guide
# ============================================================================

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Profile selection for docker-compose services
# Profiles are comma-separated and control which services start:
#   infra - Infrastructure (PostgreSQL, Keycloak, Kong) - always needed
#   api   - API services (llm-api, media-api, response-api) - always needed
#   mcp   - MCP Tools and Vector Store - always included
#   full  - Includes vLLM GPU inference (for local GPU provider)
# 
# Examples:
#   COMPOSE_PROFILES=infra,api,mcp,full  - Local vLLM (full setup with GPU)
#   COMPOSE_PROFILES=infra,api,mcp       - Remote API provider (no vLLM)
COMPOSE_PROFILES=infra,api,mcp,full

# ============================================================================
# REQUIRED: Secrets & API Keys
# ============================================================================
# You MUST set these values before running the services

# HuggingFace API token (required for model downloads). The local vLLM provider needs this token.
# If you plan to use a remote provider instead, comment this out and edit
# services/llm-api/configs/providers.yml to point at the provider you want.
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Serper API key (required for MCP google_search tool)
# Get from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Security secrets (CHANGE THESE in production!)
POSTGRES_PASSWORD=jan_password
KEYCLOAK_ADMIN_PASSWORD=admin
BACKEND_CLIENT_SECRET=backend-secret
MODEL_PROVIDER_SECRET=jan-model-provider-secret-2024
VLLM_INTERNAL_KEY=changeme

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=jan_user
POSTGRES_DB=jan_llm_api
POSTGRES_PORT=5432
KEYCLOAK_DB_PORT=5433

# Database connection (varies by environment)
# Development:  postgres://jan_user:password@api-db:5432/jan_llm_api
# Hybrid:       postgres://jan_user:password@localhost:5432/jan_llm_api
DB_POSTGRESQL_WRITE_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@api-db:5432/${POSTGRES_DB}?sslmode=disable
DB_POSTGRESQL_READ1_DSN=
MEMORY_DB_POSTGRESQL_WRITE_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@api-db:5432/${POSTGRES_DB}?sslmode=disable
MEMORY_DB_POSTGRESQL_READ1_DSN=

# ============================================================================
# LLM API Service
# ============================================================================
HTTP_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
AUTO_MIGRATE=true

# ============================================================================
# Authentication (Keycloak)
# ============================================================================
# Note: JWKS_URL uses internal Docker hostname, ISSUER uses localhost for external clients
KEYCLOAK_ADMIN=admin
KEYCLOAK_HTTP_PORT=8085
KEYCLOAK_REALM=jan

# OAuth/OIDC Configuration (varies by environment)
# Development (inside Docker): http://keycloak:8085
# External/Hybrid: set KEYCLOAK_PUBLIC_HOST to your host (e.g., localhost or LAN IP) and KEYCLOAK_PUBLIC_PORT to the exposed port.
KEYCLOAK_BASE_URL=http://keycloak:8085
KEYCLOAK_PUBLIC_HOST=localhost
KEYCLOAK_PUBLIC_PORT=${KEYCLOAK_HTTP_PORT:-8085}
KEYCLOAK_PUBLIC_URL=http://${KEYCLOAK_PUBLIC_HOST}:${KEYCLOAK_PUBLIC_PORT}
KEYCLOAK_ADMIN_URL=http://${KEYCLOAK_PUBLIC_HOST}:${KEYCLOAK_PUBLIC_PORT}
JWKS_URL=http://keycloak:8085/realms/jan/protocol/openid-connect/certs
ISSUER=${KEYCLOAK_PUBLIC_URL}/realms/${KEYCLOAK_REALM}
AUDIENCE=account
REFRESH_JWKS_INTERVAL=5m

# OAuth2 redirect URI (must match Keycloak client configuration)
# This is where Keycloak redirects after authentication
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Guest provisioning
BACKEND_CLIENT_ID=backend
TARGET_CLIENT_ID=jan-client
GUEST_ROLE=guest

# ============================================================================
# API Gateway (Kong)
# ============================================================================
KONG_HTTP_PORT=8000

# ============================================================================
# Inference (vLLM / Remote LLM)
# ============================================================================
VLLM_ENABLED=true
VLLM_PROVIDER_URL=http://vllm-jan-gpu:8001/v1
VLLM_PORT=8101
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_SERVED_NAME=qwen2.5-0.5b-instruct
VLLM_GPU_UTIL=0.66
VLLM_TOOL_SUPPORT=false

REMOTE_LLM_ENABLED=false
REMOTE_LLM_PROVIDER_URL=
REMOTE_API_KEY=

# ============================================================================
# Document OCR (Docling)
# ============================================================================
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_TIMEOUT=300s
DOCUMENT_OCR_MODEL=docling-v1
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_SUPPORTED_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/markdown,text/html,application/rtf

# Docling OCR provider (X-Api-Key auth)
DOCLING_ENABLED=false
DOCLING_PROVIDER_URL=
DOCLING_API_KEY=

# Model provider configuration
JAN_PROVIDER_CONFIGS=true
JAN_PROVIDER_CONFIGS_FILE=configs/providers.yml
JAN_PROVIDER_CONFIG_SET=default

PROMPT_ORCHESTRATION_ENABLED=true
PROMPT_ORCHESTRATION_TEMPLATES=true

CONVERSATION_SHARING_ENABLED=true

# Conversation title generation
CONVERSATION_TITLE_GENERATION_ENABLED=false
CONVERSATION_TITLE_GENERATION_MODEL_ID=LFM2-8B-A1B

# ============================================================================
# MCP Tools Service
# ============================================================================
MCP_TOOLS_HTTP_PORT=8091

# LLM API connection for tool tracking and dynamic tool descriptions
LLM_API_BASE_URL=http://llm-api:8080
MCP_TRACKING_ENABLED=true
MCP_AGENT_PROXY_ENABLED=true

# Search engine configuration
SEARCH_ENGINE=serper                 # Options: serper, exa, tavily, searxng (deprecated, use *_ENABLED flags)
SERPER_ENABLED=true                  # Enable Serper provider (requires SERPER_API_KEY)
SERPER_DOMAIN_FILTER=                # Optional: domain filter for search results
SERPER_LOCATION_HINT=                # Optional: location hint for search
SERPER_OFFLINE_MODE=false            # Set true for offline testing

# Exa API (optional fallback provider)
# Get from: https://exa.ai
EXA_API_KEY=
EXA_ENABLED=false                    # Enable Exa provider (requires EXA_API_KEY)
EXA_SEARCH_ENDPOINT=https://api.exa.ai/search
EXA_TIMEOUT=15s

# Tavily API (optional fallback provider)
# Get from: https://www.tavily.com
TAVILY_API_KEY=
TAVILY_ENABLED=false                 # Enable Tavily provider (requires TAVILY_API_KEY)
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_TIMEOUT=15s

# SearXNG (self-hosted search engine)
SEARXNG_ENABLED=false                # Enable SearXNG provider (requires SEARXNG_URL)

# MCP Provider URLs (vary by environment)
# Development:  http://searxng:8080
# Hybrid:       http://localhost:8086
SEARXNG_PORT=8086
SEARXNG_URL=http://searxng:8080
VECTOR_STORE_PORT=3015
VECTOR_STORE_URL=http://vector-store:3015
# SANDBOXFUSION_PORT=3010
# SANDBOXFUSION_URL=http://sandboxfusion:3010
# SANDBOX_FUSION_REQUIRE_APPROVAL=true
MCP_ENABLE_PYTHON_EXEC=false
MCP_ENABLE_MEMORY_RETRIEVE=false
MCP_ENABLE_FILE_SEARCH=false
MCP_ENABLE_IMAGE_GENERATE=true
# Browser automation & code execution
# CODE_SANDBOX_ENABLED=true
# CODE_SANDBOX_URL=http://code-sandbox-mcp:3000/mcp
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_URL=http://playwright-mcp:3000

# MCP debugging
MCP_PROVIDER_DEBUG=false

# ============================================================================
# Response API
# ============================================================================
RESPONSE_API_PORT=8082
RESPONSE_LOG_LEVEL=info
RESPONSE_LLM_API_URL=http://llm-api:8080
RESPONSE_MCP_TOOLS_URL=http://mcp-tools:8091
RESPONSE_MEDIA_API_URL=http://media-api:8285
RESPONSE_MAX_TOOL_DEPTH=50
RESPONSE_TOOL_TIMEOUT=300s
RESPONSE_LLM_DISABLE_CUSTOM_TEMPERATURE=false
RESPONSE_LLM_STREAM_MODE=auto
SLIDE_RENDERER_SCRIPT=
SLIDE_RENDERER_ENABLED=true
SKILL_EXECUTION_ENABLED=true
SKILL_EXECUTION_TIMEOUT=120s
SKILL_MAX_FILE_SIZE=52428800
SKILL_MAX_CODE_FIX_RETRIES=3
SKILL_MAX_INSTALL_RETRIES=3
SKILL_SLIDES_ENABLED=true
SKILL_DOCS_ENABLED=true
SKILL_PDFS_ENABLED=true
SKILL_SPREADSHEETS_ENABLED=true

# ============================================================================
# Sandbox Provider Configuration
# ============================================================================
# Choose ONE sandbox backend: "aio" (local container) or "e2b" (cloud)
# Both provide code execution, file operations, and shell access
# AIO: Local container with browser automation (requires Docker profile "aio")
# E2B: Cloud-based with desktop interaction (requires E2B_API_KEY)

# Sandbox Provider Selection (mutually exclusive: "aio", "e2b", or empty)
SANDBOX_PROVIDER=                    # Options: "aio", "e2b", or empty (disabled)

# ============================================================================
# AIO Sandbox (All-in-One Agent Sandbox)
# ============================================================================
# AIO provides browser automation, file operations, shell/terminal, and code execution
# Docs: https://sandbox.agent-infra.com/
# Note: Requires Docker profile "aio" and SANDBOX_PROVIDER=aio

# Direct Go SDK integration (recommended for high-performance tool calls)
AIO_ENABLED=false                    # Deprecated: use SANDBOX_PROVIDER=aio instead
AIO_URL=http://aio-sandbox:8080      # AIO Sandbox API URL (Docker: http://aio-sandbox:8080, Local: http://localhost:8180)
AIO_TIMEOUT=120s                     # Timeout for AIO tool calls (browser ops may take longer)
AIO_HOST_PORT=8180                   # Host port for AIO Sandbox (for local access)

# MCP Bridge (optional, for external MCP client compatibility)
AIO_MCP_BRIDGE_ENABLED=false         # Enable MCP HTTP bridge for AIO tools
AIO_MCP_URL=http://aio-sandbox:8080/mcp

# AIO Container Configuration
AIO_WORKSPACE=/home/gem              # Workspace directory inside AIO container
AIO_PROXY_SERVER=                    # Proxy server for browser (optional)
AIO_HOMEPAGE=                        # Default homepage for browser (optional)
AIO_BROWSER_EXTRA_ARGS=              # Extra Chromium args (optional)

# ============================================================================
# E2B Sandbox (Cloud-based Desktop Sandbox)
# ============================================================================
# E2B provides cloud-based desktop with browser, code execution, and GUI interaction
# Docs: https://e2b.dev
# Note: Requires Docker profile "e2b" and SANDBOX_PROVIDER=e2b

# E2B Cloud Configuration
E2B_API_KEY=                         # E2B API key (required when SANDBOX_PROVIDER=e2b)
E2B_ACCESS_TOKEN=                    # E2B access token for authenticated operations
E2B_TEMPLATE_ID=jan-browser-sandbox  # E2B sandbox template ID
E2B_SERVICE_URL=http://e2b-service:8095  # E2B service URL (internal)
E2B_TIMEOUT=120s                     # Timeout for E2B tool calls
E2B_SANDBOX_TIMEOUT=1800             # E2B sandbox timeout in seconds (30 min default)
E2B_LOG_LEVEL=INFO                   # E2B service log level

# E2B Database Configuration (dedicated database for sandbox state)
# The E2B service uses a separate database to track sandbox sessions and state
E2B_DB_HOST=api-db                   # Database host (uses shared PostgreSQL)
E2B_DB_PORT=5432                     # Database port
E2B_DB_USER=sandbox                  # Database user for E2B service
E2B_DB_PASSWORD=sandbox              # Database password for E2B service
E2B_DB_NAME=e2b_sandbox              # Database name for E2B service

# ============================================================================
# Observability (OpenTelemetry, Prometheus, Jaeger, Grafana)
# ============================================================================
OTEL_ENABLED=false                   # Enable telemetry collection
OTEL_SERVICE_NAME=llm-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317

# Monitoring stack ports
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# Media API Configuration
# ============================================================================
MEDIA_API_ENABLED=true
MEDIA_API_PORT=8285
MEDIA_SERVICE_KEY=changeme-media-key
MEDIA_API_KEY=changeme-media-key

# Storage backend selection: "s3" or "local"
MEDIA_STORAGE_BACKEND=local

# Local Storage Configuration (used when MEDIA_STORAGE_BACKEND=local)
MEDIA_LOCAL_STORAGE_PATH=./media-data
MEDIA_LOCAL_STORAGE_BASE_URL=http://localhost:8285/v1/files

# S3 Storage Configuration (used when MEDIA_STORAGE_BACKEND=s3)
# MEDIA_S3_ENDPOINT=https://s3.menlo.ai
# MEDIA_S3_PUBLIC_ENDPOINT=
# MEDIA_S3_URL_ENABLED=false
# MEDIA_S3_REGION=us-west-2
# MEDIA_S3_BUCKET=platform-dev
# MEDIA_S3_ACCESS_KEY_ID=7N33WPTUI1KN99MFILQS
# MEDIA_S3_SECRET_ACCESS_KEY=ppxQsHpnfDSewYZD065aGjQeEQ0nTFA7c2aHNPz5
# MEDIA_S3_USE_PATH_STYLE=true
# MEDIA_S3_PRESIGN_TTL=5m

# Media service URLs
MEDIA_API_URL=http://media-api:8285
MEDIA_PUBLIC_URL=http://localhost:8000
MEDIA_RESOLVE_URL=http://media-api:8285/v1/media/resolve
MEDIA_RESOLVE_TIMEOUT=5s

# Media processing settings
MEDIA_MAX_BYTES=20971520
MEDIA_PROXY_DOWNLOAD=true
MEDIA_RETENTION_DAYS=30
MEDIA_REMOTE_FETCH_TIMEOUT=15s

# ============================================================================
# Realtime API (LiveKit Integration)
# ============================================================================
# OpenAI Realtime API compatible service using LiveKit as transport
# Uses global auth settings (ISSUER, AUDIENCE, JWKS_URL) when AUTH_ENABLED=true
REALTIME_API_ENABLED=true
REALTIME_API_PORT=8186

# LiveKit Configuration (required)
LIVEKIT_WS_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL=24h

# Session management
SESSION_CLEANUP_INTERVAL=15s
SESSION_STALE_TTL=10m

# ============================================================================
# Template API (copy when running the scaffold locally)
# ============================================================================
# TEMPLATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/template_api?sslmode=disable
# SERVICE_NAME=template-api
# ENVIRONMENT=development
# HTTP_PORT=8185
# LOG_LEVEL=info
# ENABLE_TRACING=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SHUTDOWN_TIMEOUT=10s
# DB_MAX_IDLE_CONNS=5
# DB_MAX_OPEN_CONNS=15
# DB_CONN_MAX_LIFETIME=30m
# AUTH_ENABLED=false
# AUTH_ISSUER=http://localhost:8080/realms/jan
# AUTH_AUDIENCE=account
# AUTH_JWKS_URL=http://localhost:8080/realms/jan/protocol/openid-connect/certs

# ============================================================================
# Connectors (OAuth Integrations)
# ============================================================================
# External service connectors allowing AI to access user data with OAuth

# GitHub Connector (full read/write access)
GITHUB_CONNECTOR_ENABLED=false
GITHUB_CLIENT_ID=                     # Get from: https://github.com/settings/developers
GITHUB_CLIENT_SECRET=

# Google Connectors (Gmail, Drive, Calendar)
# All Google connectors share the same OAuth client
GOOGLE_CONNECTOR_ENABLED=false
GOOGLE_CLIENT_ID=                     # Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=

# Connector security settings
CONNECTOR_TOKEN_ENCRYPTION_KEY=       # 32 bytes hex-encoded (64 chars) for AES-256-GCM
OAUTH_STATE_SECRET=                   # 32 bytes hex-encoded for HMAC signing
OAUTH_STATE_EXPIRATION=5m
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/v1/connectors
OAUTH_FRONTEND_URL=http://localhost:3001/connectors/callback

# MCP Tools Connector Integration
MCP_ENABLE_GITHUB_CONNECTOR=false
MCP_ENABLE_GMAIL_CONNECTOR=false
MCP_ENABLE_DRIVE_CONNECTOR=false
MCP_ENABLE_CALENDAR_CONNECTOR=false

# ============================================================================
# Analytics (PostHog + OpenTelemetry)
# ============================================================================
# Unified analytics system supporting PostHog and OTel backends
# See docs/plans/posthog-otel-unified-analytics.md for details

# Master switch for all analytics
ANALYTICS_ENABLED=true

# PostHog Configuration (EU instance)
POSTHOG_ENABLED=false
POSTHOG_API_KEY=                      # Get from: https://eu.posthog.com
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_DEBUG=false
POSTHOG_BATCH_SIZE=100
POSTHOG_FLUSH_INTERVAL=10s

# OTel Analytics Backend (uses existing OTEL_* settings)
OTEL_ANALYTICS=false

# Privacy settings
# Options: none (redact all), hashed (hash PII), full (no sanitization)
ANALYTICS_PII_LEVEL=hashed

# Environment for segmentation (dev, staging, prod)
# Used to distinguish development vs production data in PostHog
ANALYTICS_ENVIRONMENT=dev

# ============================================================================
# Environment-Specific Overrides
# ============================================================================
# The above values work for Docker development (all services in containers)
# 
# For other environments, use:
