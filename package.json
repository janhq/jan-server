{
  "name": "jan",
  "version": "0.1.0",
  "private": true,
  "description": "Jan Platform - AI-powered microservices with web interfaces",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @janhq/interfaces build && pnpm --filter @janhq/web dev",
    "build": "pnpm --filter @janhq/interfaces build && pnpm -r build",
    "build:interfaces": "pnpm --filter @janhq/interfaces build",
    "build:web": "pnpm --filter @janhq/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name 'build' -type d -prune -exec rm -rf '{}' +",
    "backend:up": "make up-full",
    "backend:down": "make down",
    "backend:setup": "make setup",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5",
      "form-data": "^4.0.1"
    }
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
